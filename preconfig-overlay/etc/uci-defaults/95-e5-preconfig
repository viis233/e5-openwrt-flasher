#!/bin/sh
# e5 preconfig: apply the customization checklist at first boot.
# LAN / WiFi / OpenSSH / ZeroTier / OpenClash / power-save are preset here;
# secrets (__WIFI_KEY__, __ZT_NETWORK__, __ROOT_PASSWORD__) are injected at
# build time by build/apply-preconfig.sh (never committed).
# 容错执行：单步失败不中断其余配置（uci-defaults 以正常退出为成功标志）。
# SSH：sshd 主用 22，dropbear 保留在 2222 备用——保证刷机后总有登录入口。

# ---- LAN (10.0.55.1 single address, DHCP 10/191, USB host .2) ----
uci -q delete network.lan.ipaddr 2>/dev/null || true
uci add_list network.lan.ipaddr='10.0.55.1/24' 2>/dev/null || true
uci -q set dhcp.lan.start='10' 2>/dev/null || true
uci -q set dhcp.lan.limit='191' 2>/dev/null || true
uci -q set dhcp.usb_host.ip='10.0.55.2' 2>/dev/null || true
uci commit network 2>/dev/null || true
uci commit dhcp 2>/dev/null || true

# ---- WiFi hotspot (WingZaiNetwork-e5, ch149 VHT80, psk2+ccmp) ----
uci -q set wireless.default_radio0.ssid='WingZaiNetwork-e5' 2>/dev/null || true
uci -q set wireless.default_radio0.encryption='psk2+ccmp' 2>/dev/null || true
uci -q set wireless.default_radio0.key='__WIFI_KEY__' 2>/dev/null || true
uci -q set wireless.radio0.channel='149' 2>/dev/null || true
uci -q set wireless.radio0.htmode='VHT80' 2>/dev/null || true
uci -q set wireless.radio0.disabled='0' 2>/dev/null || true
uci commit wireless 2>/dev/null || true

# ---- SSH：sshd 主用 22；dropbear 改 2222 备用（不停用，保证登录入口）----
uci -q set dropbear.@dropbear[0].enable='1' 2>/dev/null || true
uci -q set dropbear.@dropbear[0].Port='2222' 2>/dev/null || true
uci commit dropbear 2>/dev/null || true
sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null || true
sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true
sed -i 's/^#\?Port .*/Port 22/' /etc/ssh/sshd_config 2>/dev/null || true
/etc/init.d/dropbear enable 2>/dev/null || true
/etc/init.d/dropbear restart 2>/dev/null || true
/etc/init.d/sshd enable 2>/dev/null || true
/etc/init.d/sshd restart 2>/dev/null || true

# ---- root password (secret, injected at build time) ----
echo "root:__ROOT_PASSWORD__" | chpasswd 2>/dev/null || true

# ---- ZeroTier network ----
uci -q set zerotier.earth.id='__ZT_NETWORK__' 2>/dev/null || true
uci -q set zerotier.global.enabled='1' 2>/dev/null || true
uci commit zerotier 2>/dev/null || true
/etc/init.d/zerotier enable 2>/dev/null || true

# ---- OpenClash（预装）：启用 + 指向注入的订阅；dashboard 密码由 OpenClash 首次运行自动生成 ----
uci -q set openclash.config.enable='1' 2>/dev/null || true
uci -q set openclash.config.config_path='/etc/openclash/config/liangxin.yaml' 2>/dev/null || true
uci commit openclash 2>/dev/null || true

# ---- hotspotdata（USB 围栏）默认启用 ----
uci -q set e5-plugin-hotspotdata.settings.enabled='1' 2>/dev/null || true
uci commit e5-plugin-hotspotdata 2>/dev/null || true

exit 0
