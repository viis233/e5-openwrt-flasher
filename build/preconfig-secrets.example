# 构建机密文件示例：复制到构建机 /root/e5/secrets/preconfig.env 并填写真实值。
# 本文件绝不提交到 git（.gitignore 排除 /root/e5/secrets 或仓库内 secrets）。
# WIFI_KEY    WiFi 热点密码（刷机后即预置）
# ZT_NETWORK  ZeroTier 网络 ID（如 52b337794f9b0193）
# ROOT_PASSWORD  SSH/root 密码
WIFI_KEY=CHANGE_ME_WIFI_PASSWORD
ZT_NETWORK=CHANGE_ME_ZEROTIER_NETWORK
ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
